---
import type { Lang } from "@lib/i18n"
import { CONTACT } from "@consts"

const { lang = "en" } = Astro.props as { lang?: Lang }
const fr = lang === "fr"
const EMAIL = CONTACT.EMAIL
const bookingHref = CONTACT.BOOKING_URL
  || `mailto:${CONTACT.EMAIL}?subject=${encodeURIComponent(fr ? "Entretien — prise de créneau" : "Interview — let's book a slot")}`
const bookingLabel = fr ? "Proposer un créneau" : "Book a slot"
const pill = "inline-flex items-center gap-2 px-5 py-2.5 rounded-full border border-black/10 dark:border-white/20 bg-white dark:bg-black text-black dark:text-white hover:bg-black/5 dark:hover:bg-white/10 transition-colors duration-300 font-medium"
---

<div class="space-y-10 max-w-2xl">
  <div class="flex items-center gap-3 p-4 border rounded-lg border-green-600/30 dark:border-green-400/30 bg-green-50/60 dark:bg-green-900/20">
    <span class="relative flex h-3 w-3 shrink-0">
      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-300"></span>
      <span class="relative inline-flex rounded-full h-3 w-3 bg-green-500"></span>
    </span>
    <span class="text-sm font-medium text-green-700 dark:text-green-300">
      {fr
        ? "Disponible immédiatement — full remote (Europe), chevauchement avec les US East Coast l'après-midi"
        : "Available immediately — full remote (Europe), afternoon overlap with US Eastern"}
    </span>
  </div>

  <div>
    <h3 class="font-semibold mb-2">{fr ? "E-mail (le plus rapide)" : "Email (fastest)"}</h3>
    <div class="flex flex-wrap items-center gap-3">
      <a href={`mailto:${EMAIL}`} class="font-mono text-sm underline underline-offset-4 hover:text-black dark:hover:text-white transition-colors">{EMAIL}</a>
      <button id="copy-email-btn" data-email={EMAIL} class="text-xs px-3 py-1.5 rounded-full border border-black/15 dark:border-white/25 hover:bg-black/5 dark:hover:bg-white/10 transition-colors">
        <span id="copy-email-label">{fr ? "Copier" : "Copy"}</span>
      </button>
    </div>
    <p class="text-sm text-gray-600 dark:text-gray-400 mt-2">
      {fr ? CONTACT.RESPONSE_TIME_FR : CONTACT.RESPONSE_TIME_EN}
    </p>
    <div class="flex flex-wrap gap-3 mt-3">
      <a href={bookingHref} class={pill}>
        {bookingLabel} →
      </a>
      <a href={fr ? "/fr/recruiters" : "/recruiters"} class="inline-flex items-center px-2 py-2.5 text-sm font-medium text-gray-600 dark:text-gray-300 underline underline-offset-4 decoration-black/30 dark:decoration-white/30 hover:text-black dark:hover:text-white transition-colors duration-300">
        {fr ? "Espace recruteurs" : "For recruiters"}
      </a>
    </div>
  </div>

  <div>
    <h3 class="font-semibold mb-3">{fr ? "Profils en ligne" : "Online profiles"}</h3>
    <div class="flex flex-col gap-3">
      <a href="https://www.linkedin.com/in/roussel-alexandre/" target="_blank" class="group flex items-center justify-between gap-4 px-4 py-3 rounded-lg border border-black/15 dark:border-white/25 hover:bg-black/5 dark:hover:bg-white/10 transition-colors">
        <span>
          <span class="block font-semibold text-sm">{fr ? "LinkedIn — mon profil complet" : "LinkedIn — full experience & recommendations"}</span>
          <span class="block text-xs text-gray-600 dark:text-gray-400 mt-0.5 font-mono">linkedin.com/in/roussel-alexandre</span>
        </span>
        <span class="text-sm font-medium group-hover:translate-x-0.5 transition-transform">→</span>
      </a>
      <a href="https://github.com/Alex14460" target="_blank" class="group flex items-center justify-between gap-4 px-4 py-3 rounded-lg border border-black/15 dark:border-white/25 hover:bg-black/5 dark:hover:bg-white/10 transition-colors">
        <span>
          <span class="block font-semibold text-sm">{fr ? "GitHub — code & scripts" : "GitHub — code & scripts"}</span>
          <span class="block text-xs text-gray-600 dark:text-gray-400 mt-0.5 font-mono">github.com/Alex14460</span>
        </span>
        <span class="text-sm font-medium group-hover:translate-x-0.5 transition-transform">→</span>
      </a>
    </div>
  </div>

  <div>
    <h3 class="font-semibold mb-2">{fr ? "Disponibilité & fuseau" : "Availability & timezone"}</h3>
    <p class="text-sm text-gray-600 dark:text-gray-400">
      {fr
        ? "Basé en Europe (CET/CEST). Horaires habituels 9 h – 18 h, flexibles pour les entretiens."
        : "Based in Europe (CET/CEST). Usual hours 9:00–18:00, flexible for interviews."}
    </p>
  </div>

  <div>
    <h3 class="font-semibold mb-3">CV</h3>
    <div class="flex flex-wrap gap-4">
      <a href="/cv-fr?from=contact" class={pill}>{fr ? "Télécharger le CV (FR)" : "CV en français"}</a>
      <a href="/cv?from=contact" class={pill}>{fr ? "Download CV (EN)" : "CV (English)"}</a>
    </div>
  </div>
</div>

<script is:inline>
  function initializeCopyEmail() {
    const btn = document.getElementById("copy-email-btn")
    if (!btn) return
    btn.addEventListener("click", () => {
      navigator.clipboard.writeText(btn.getAttribute("data-email")).then(() => {
        const label = document.getElementById("copy-email-label")
        if (!label) return
        const old = label.textContent
        label.textContent = "✓"
        setTimeout(() => { label.textContent = old }, 1200)
      })
    })
  }
  document.addEventListener("astro:after-swap", initializeCopyEmail)
  initializeCopyEmail()
</script>
