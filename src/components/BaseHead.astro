---
import { ViewTransitions } from "astro:transitions"
import { SITE, CONTACT } from "@consts"

interface Props {
  title: string
  description: string
  image?: string
  type?: "website" | "article" | "profile"
  publishedTime?: string
  modifiedTime?: string
  author?: string
  tags?: string[]
  alternates?: { hreflang: string; href: string }[]
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site)

const { title, description, image = "/open-graph.jpg", type = "website", publishedTime, modifiedTime, author, tags, alternates } = Astro.props

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://alexandreroussel.com"

const isPerson = type === "profile"

const jsonLd = {
  "@context": "https://schema.org",
  "@type": isPerson ? "Person" : type === "article" ? "BlogPosting" : "WebSite",
  name: title,
  description: description,
  url: canonicalURL.toString(),
  image: new URL(isPerson ? "/profile.jpg" : image, Astro.url).toString(),
  headline: type === "article" ? title.split(" | ")[0] : undefined,
  ...(isPerson && {
    jobTitle: "Customer Support & Account Management",
    email: `mailto:${CONTACT.EMAIL}`,
    sameAs: [
      "https://www.linkedin.com/in/roussel-alexandre/",
      "https://github.com/Alex14460",
    ],
    knowsLanguage: ["fr", "en", "es"],
    knowsAbout: [
      "Customer Support",
      "Account Management",
      "Cryptocurrency",
      "Fintech",
      "SaaS",
      "KYC / AML",
      "Trading Support",
      "Remote collaboration",
    ],
    address: {
      "@type": "PostalAddress",
      addressRegion: "Europe",
    },
    workLocation: {
      "@type": "Place",
      name: "Europe / Full remote",
    },
  }),
  author: author ? {
    "@type": "Person",
    name: author,
    url: `${siteUrl}/`,
    sameAs: [
      "https://www.linkedin.com/in/roussel-alexandre/",
      "https://github.com/Alex14460",
    ],
  } : undefined,
  publisher: {
    "@type": "Person",
    name: "Alexandre Roussel",
    logo: {
      "@type": "ImageObject",
      url: `${siteUrl}/brand.svg`,
    },
  },
  datePublished: publishedTime,
  dateModified: modifiedTime || publishedTime,
  keywords: tags?.join(", "),
  mainEntityOfPage: type === "article" ? {
    "@type": "WebPage",
    "@id": canonicalURL.toString(),
  } : undefined,
  potentialAction: type === "website" ? {
    "@type": "SearchAction",
    target: {
      "@type": "EntryPoint",
      urlTemplate: `${siteUrl}/search?q={search_term_string}`,
    },
    "query-input": "required name=search_term_string",
  } : undefined,
}
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />

<link rel="preload" href="/fonts/atkinson-regular.woff" as="font" type="font/woff" crossorigin>
<link rel="preload" href="/fonts/atkinson-bold.woff" as="font" type="font/woff" crossorigin>

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Hreflang alternates -->
{alternates?.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="theme-color" content="#fafaf8" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#121214" media="(prefers-color-scheme: dark)" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />
<meta property="og:site_name" content="Alexandre Roussel" />
{type === "article" && publishedTime && <meta property="article:published_time" content={publishedTime} />}
{type === "article" && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
{type === "article" && author && <meta property="article:author" content={author} />}
{tags && tags.map((tag) => <meta property="article:tag" content={tag} />)}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.url)} />
<meta property="twitter:creator" content="@Alex14460" />

<!-- Sitemap -->
<link rel="sitemap" href="/sitemap-index.xml" />

<!-- RSS Feed -->
<link rel="alternate" type="application/rss+xml" title={SITE.TITLE} href={`${Astro.site}rss.xml`} />

<!-- JSON-LD Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLd, null, 2)} />

<!-- Global Scripts -->
<script is:inline>document.documentElement.classList.add("js")</script>
<script is:inline src="/js/theme.js"></script>
<script is:inline src="/js/scroll.js"></script>
<script is:inline src="/js/animate.js"></script>
<script defer is:inline src="/js/copy.js"></script>

<!-- Cloudflare Web Analytics (beacon rendered only when PUBLIC_CF_BEACON_TOKEN is set;
     `spa: true` counts Astro View Transitions navigations; kept in <head> so the
     client-side router does not tear it down between pages) -->
{import.meta.env.PUBLIC_CF_BEACON_TOKEN && (
  <script
    is:inline
    defer
    src="https://static.cloudflareinsights.com/beacon.min.js"
    data-cf-beacon={JSON.stringify({ token: import.meta.env.PUBLIC_CF_BEACON_TOKEN, spa: true })}
  />
)}

<!-- ViewTransitions -->
<ViewTransitions />

<script>
  import type { TransitionBeforeSwapEvent } from "astro:transitions/client"
  document.addEventListener("astro:before-swap", (e) =>
    [
      ...(e as TransitionBeforeSwapEvent).newDocument.head.querySelectorAll(
        "link[as=\"font\"]"
      ),
    ].forEach((link) => link.remove())
  )
</script>