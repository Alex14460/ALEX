---
import { type CollectionEntry, getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import TopLayout from "@layouts/TopLayout.astro";
import BottomLayout from "@layouts/BottomLayout.astro";
import Search from "@components/Search";
import { SEARCH } from "@consts";

const posts = (await getCollection("blog")).filter((post) => !post.data.draft);

const postsFr = (await getCollection("blogfr")).filter((post) => !post.data.draft);

const projects = (await getCollection("projects")).filter(
  (post) => !post.data.draft,
);

// Work entries have no title/date/tags of their own: shape them for the shared
// ArrowCard ("Company — Role" title, dateStart as the date, company as the tag).
const work = (await getCollection("work")).map((entry) => ({
  ...entry,
  data: {
    ...entry.data,
    title: `${entry.data.company} — ${entry.data.role}`,
    date: entry.data.dateStart,
    tags: [entry.data.company],
  },
}));

const data = [...posts, ...postsFr, ...projects, ...work] as CollectionEntry<"blog">[];
---

<PageLayout title={SEARCH.TITLE} description={SEARCH.DESCRIPTION}>
  <TopLayout>
    <h1 class="animate page-heading">
      {SEARCH.TITLE}
    </h1>
  </TopLayout>
  <BottomLayout>
    <div class="animate">
      <Search client:load data={data} />
    </div>
  </BottomLayout>
</PageLayout>
