---
import PageLayout from '@layouts/PageLayout.astro'
import TopLayout from '@layouts/TopLayout.astro'
import BottomLayout from '@layouts/BottomLayout.astro'
import { SITE } from '@consts'
import { getCollection } from 'astro:content'
import ArrowCard from '@components/ArrowCard.tsx'

const workCollection = await getCollection('workfr')
workCollection.sort((a, b) => new Date(b.data.dateStart).getTime() - new Date(a.data.dateStart).getTime())
const recentWork = workCollection.slice(0, 4)

const blogCollection = await getCollection('blog')
blogCollection.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
const recentBlog = blogCollection.filter(p => !p.data.draft).slice(0, 2)

const projectsCollection = await getCollection('projects')
projectsCollection.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
const recentProjects = projectsCollection.slice(0, 2)

function formatWorkDate(input: Date | string) {
  if (typeof input === 'string') return input
  const month = input.toLocaleDateString('fr-FR', { month: 'short' })
  const year = new Date(input).getFullYear()
  return `${month.charAt(0).toUpperCase() + month.slice(1)} ${year}`
}
---

<PageLayout lang="fr" title={SITE.TITLE} description="Support Client & Gestion de Comptes — SaaS, Fintech, Crypto. Bilingue FR/EN." type="profile" author="Alexandre Roussel">
  <TopLayout>
    <div class="animate page-heading text-4xl md:text-6xl font-bold tracking-tight">
      Alexandre Roussel
    </div>
    <div class="animate mt-4 text-lg md:text-xl text-gray-600 dark:text-gray-300 max-w-2xl">
      Support Client & Gestion de Comptes — SaaS, Fintech, Crypto. Bilingue FR/EN.
    </div>
    <div class="animate mt-6 flex flex-wrap gap-4">
      <a href="/fr/work" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full border border-black/10 dark:border-white/20 bg-white dark:bg-black text-black dark:text-white hover:bg-black/5 dark:hover:bg-white/10 transition-colors duration-300 font-medium">
        Expérience
      </a>
      <a href="/projects" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full border border-black/10 dark:border-white/20 bg-white dark:bg-black text-black dark:text-white hover:bg-black/5 dark:hover:bg-white/10 transition-colors duration-300 font-medium">
        Projets
      </a>
      <a href="/blog" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full border border-black/10 dark:border-white/20 bg-white dark:bg-black text-black dark:text-white hover:bg-black/5 dark:hover:bg-white/10 transition-colors duration-300 font-medium">
        Blog
      </a>
      <a href="/cv-fr" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full border border-black/10 dark:border-white/20 bg-white dark:bg-black text-black dark:text-white hover:bg-black/5 dark:hover:bg-white/10 transition-colors duration-300 font-medium">
        Télécharger le CV
      </a>
      <a href="/cv" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full border border-black/10 dark:border-white/20 bg-white dark:bg-black text-black dark:text-white hover:bg-black/5 dark:hover:bg-white/10 transition-colors duration-300 font-medium">
        CV (EN)
      </a>
    </div>
    <div class="animate mt-8 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-gray-500 dark:text-gray-400 font-mono">
      <span class="inline-flex items-center gap-1.5">
        <svg class="size-4 stroke-current"><use href="/ui.svg#pin"></use></svg>
        {SITE.LOCATION}
      </span>
      <span>·</span>
      <span class="inline-flex items-center gap-1.5">
        <svg class="size-4 fill-current"><use href="/ui.svg#globe"></use></svg>
        {SITE.LANGUAGES.join(' · ')}
      </span>
    </div>
  </TopLayout>

  <BottomLayout>
    {recentWork.length > 0 && (
      <section class="py-12 border-t border-black/10 dark:border-white/25">
        <h2 class="text-2xl font-bold mb-8">Expériences récentes</h2>
        <div class="grid gap-6 md:grid-cols-2">
          {recentWork.map((entry) => (
            <article class="p-6 border border-black/10 dark:border-white/20 rounded-lg bg-white/50 dark:bg-black/50 hover:border-black/20 dark:hover:border-white/30 transition-colors duration-300 h-full">
              <div class="text-sm uppercase mb-3 text-gray-500 dark:text-gray-400 font-mono">
                {formatWorkDate(entry.data.dateStart)} – {formatWorkDate(entry.data.dateEnd)}
              </div>
              <h3 class="font-semibold text-black dark:text-white mb-1">{entry.data.company}</h3>
              <p class="text-sm font-medium text-gray-600 dark:text-gray-300 mb-4">{entry.data.role}</p>
              <p class="text-sm text-gray-600 dark:text-gray-300">{entry.data.summary}</p>
              <a href={`/fr/work#${entry.slug}`} class="inline-flex items-center gap-1 mt-4 text-sm font-medium text-black dark:text-white hover:text-gray-600 dark:hover:text-gray-300 transition-colors">
                Voir le détail →
              </a>
            </article>
          ))}
        </div>
        <div class="mt-8 text-center">
          <a href="/fr/work" class="inline-flex items-center gap-2 text-sm font-medium text-black dark:text-white hover:text-gray-600 dark:hover:text-gray-300 transition-colors">
            Voir toutes les expériences →
          </a>
        </div>
      </section>
    )}

    {recentBlog.length > 0 && (
      <section class="py-12 border-t border-black/10 dark:border-white/25">
        <h2 class="text-2xl font-bold mb-8">Derniers articles</h2>
        <div class="grid gap-6 md:grid-cols-2">
          {recentBlog.map((entry) => (
            <ArrowCard entry={entry} pill={true} />
          ))}
        </div>
        <div class="mt-8 text-center">
          <a href="/blog" class="inline-flex items-center gap-2 text-sm font-medium text-black dark:text-white hover:text-gray-600 dark:hover:text-gray-300 transition-colors">
            Voir tous les articles →
          </a>
        </div>
      </section>
    )}

    {recentProjects.length > 0 && (
      <section class="py-12 border-t border-black/10 dark:border-white/25">
        <h2 class="text-2xl font-bold mb-8">Projets en vedette</h2>
        <div class="grid gap-6 md:grid-cols-2">
          {recentProjects.map((entry) => (
            <ArrowCard entry={entry} pill={true} />
          ))}
        </div>
        <div class="mt-8 text-center">
          <a href="/projects" class="inline-flex items-center gap-2 text-sm font-medium text-black dark:text-white hover:text-gray-600 dark:hover:text-gray-300 transition-colors">
            Voir tous les projets →
          </a>
        </div>
      </section>
    )}
  </BottomLayout>
</PageLayout>
