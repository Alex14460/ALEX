---
import { getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import TopLayout from "@layouts/TopLayout.astro"
import BottomLayout from "@layouts/BottomLayout.astro"

const posts = (await getCollection("blogfr"))
  .filter((p: any) => !p.data.draft)
  .sort((a: any, b: any) => b.data.date.getTime() - a.data.date.getTime())

function formatDateFR(d: Date) {
  return d.toLocaleDateString("fr-FR", { month: "long", year: "numeric" })
}
---

<PageLayout lang="fr" title="Blog" description="Mes articles : crypto, airdrops, IA appliquée, support client.">
  <TopLayout>
    <div class="animate">
      <h1 class="text-3xl font-semibold text-black dark:text-white mt-2">Blog</h1>
      <div class="mt-1">Mes articles — crypto, IA appliquée, support client.</div>
    </div>
  </TopLayout>
  <BottomLayout>
    <ul>
      {posts.map((post) => (
        <li class="animate border-b border-black/10 dark:border-white/25 last-of-type:border-none">
          <a href={`/fr/blog/${post.slug}`} class="block py-8 group">
            <div class="text-sm uppercase opacity-70">{formatDateFR(post.data.date)}</div>
            <div class="text-xl font-semibold text-black dark:text-white mt-1 group-hover:underline underline-offset-4">{post.data.title}</div>
            <div class="text-gray-600 dark:text-gray-400 mt-2 max-w-2xl">{post.data.summary}</div>
            <div class="mt-3 flex flex-wrap gap-2">
              {post.data.tags.map((t: string) => (
                <span class="px-3 py-1 rounded-full text-xs border border-black/15 dark:border-white/25 opacity-80">{t}</span>
              ))}
            </div>
          </a>
        </li>
      ))}
    </ul>
  </BottomLayout>
</PageLayout>
