---
import "@styles/global.css"
import BaseHead from "@components/BaseHead.astro"
import Header from "@components/Header.astro"
import Footer from "@components/Footer.astro"
import Drawer from "@components/Drawer.astro"
import { langFromPathname, alternatesFor } from "@lib/i18n"
import { SITE } from "@consts"

const { title, description, image, type, publishedTime, modifiedTime, author, tags, lang = langFromPathname(Astro.url.pathname) } = Astro.props
const fullTitle = type === "profile" ? title : `${title} | ${SITE.TITLE}`
const alternates = Astro.site ? alternatesFor(Astro.url.pathname, Astro.site.toString()) : undefined
---

<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead title={fullTitle} description={description} image={image} type={type} publishedTime={publishedTime} modifiedTime={modifiedTime} author={author} tags={tags} alternates={alternates} />
  </head>
  <body>
    <Header lang={lang} />
    <Drawer lang={lang} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>