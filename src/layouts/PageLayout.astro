---
import "@styles/global.css"
import BaseHead from "@components/BaseHead.astro"
import Header from "@components/Header.astro"
import Footer from "@components/Footer.astro"
import Drawer from "@components/Drawer.astro"
const { title, description, image, type, publishedTime, modifiedTime, author, tags } = Astro.props
import { SITE } from "@consts"

const fullTitle = type === "profile" ? title : `${title} | ${SITE.TITLE}`
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={fullTitle} description={description} image={image} type={type} publishedTime={publishedTime} modifiedTime={modifiedTime} author={author} tags={tags} />
  </head>
  <body>
    <Header />
    <Drawer />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>